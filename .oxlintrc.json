{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": {
    "builtin": true,
    "node": true
  },
  "ignorePatterns": [
    "node_modules/",
    "coverage/",
    "*.tgz",
    "tests/terraform-0.1.3/",
    "tests/history/",
    "lib/legacy-contracts/"
  ],
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ]
  }
}
